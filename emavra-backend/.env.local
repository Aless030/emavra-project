APP_NAME=EMAVRA
APP_ENV=local
APP_KEY=base64:efdnbli2ujgcV4JEgrdhFo3eP1nUpBhGrzy7CCj3MfA=
APP_DEBUG=true
APP_URL=http://localhost:8002

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL Database
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=emavraforestaldb_dev
DB_USERNAME=emavraforestal_user
DB_PASSWORD=emavraforestal_pass

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Frontend URL (para CORS y QR codes)
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DOMAIN=localhost

# Configuración de archivos
UPLOAD_MAX_FILESIZE=10M
POST_MAX_SIZE=10M