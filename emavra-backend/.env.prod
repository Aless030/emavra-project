APP_NAME=EMAVRA
APP_ENV=production
APP_KEY=base64:GENERA_UNA_KEY_AQUI
APP_DEBUG=false
APP_URL=http://TU_DOMINIO_O_IP:8001

LOG_CHANNEL=stack
LOG_LEVEL=error

# PostgreSQL PRODUCCIÓN (remoto)
DB_CONNECTION=pgsql
DB_HOST=192.168.104.201
DB_PORT=5432
DB_DATABASE=emavraforestaldb_dev
DB_USERNAME=emavraforestal_user
DB_PASSWORD=emavraforestal_pass

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Frontend URL para CORS
FRONTEND_URL=http://TU_DOMINIO_O_IP:8002
SANCTUM_STATEFUL_DOMAINS=TU_DOMINIO_O_IP:8002
SESSION_DOMAIN=.tudominio.com